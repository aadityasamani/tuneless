{
  "name": "@tuneless/desktop",
  "version": "2.0.7",
  "description": "Tuneless desktop music player",
  "author": "Aaditya Samani",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "generate-icon": "node scripts/render-icon.js"
  },
  "build": {
    "appId": "com.tuneless.desktop",
    "productName": "Tuneless",
    "copyright": "Copyright © 2026 Tuneless",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "renderer/**/*", "assets/**/*"],
    "extraResources": [{"from": "yt-dlp.exe", "to": "yt-dlp.exe"}],
    "win": {
      "target": [{"target": "nsis", "arch": ["x64"]}],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tuneless",
      "artifactName": "Tuneless-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3"
  }
}
